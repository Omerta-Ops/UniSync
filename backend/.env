# UniSync Backend Environment Variables

# ── App ──────────────────────────────────────────────────────────────
APP_NAME=UniSync
DEBUG=true
ENVIRONMENT=development

# ── CORS ─────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Supabase ─────────────────────────────────────────────────────────
